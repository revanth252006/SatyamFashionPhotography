# =============================================================================
# Server Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Use anon key for client-safe operations, or service_role key for backend admin operations
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# -----------------------------------------------------------------------------
# Google Drive API v3 Configuration
# Options:
# 1. API Key (simplest for publicly shared "Anyone with the link can view" folders)
# 2. Service Account (recommended for production & private shared folders)
# -----------------------------------------------------------------------------
GOOGLE_DRIVE_API_KEY=your_google_cloud_api_key_here

# Optional: Google Service Account credentials (for private folders shared with service account)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=wedding-gallery@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or path to service-account.json file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# -----------------------------------------------------------------------------
# In-Memory Cache Configuration
# -----------------------------------------------------------------------------
# Time-To-Live in seconds for Google Drive folders & photo listings (e.g., 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Cache sweep interval in seconds to purge expired entries
CACHE_CLEANUP_INTERVAL_SECONDS=60
